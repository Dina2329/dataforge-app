# Copy this to .env next to docker-compose.prod.yml and fill in real values.
# Never commit the filled-in .env -- it holds production secrets.

# Where images were pushed, e.g. docker.io/youruser or a private registry host.
REGISTRY=docker.io/youruser
TAG=latest

# Port the frontend (nginx) listens on, on this host.
HTTP_PORT=80

POSTGRES_PASSWORD=change-me

# Any long random string -- used to sign JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me

# A Fernet key used to encrypt stored data-source credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

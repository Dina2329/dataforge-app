# Copy to .env and fill in real values -- see ../INSTALL.md for a full
# from-zero setup guide, including how to generate JWT_SECRET/ENCRYPTION_KEY.
DATABASE_URL=postgresql+asyncpg://dataforge:dataforge@localhost:5544/dataforge
REDIS_URL=redis://localhost:6390/0

# Never reuse the defaults baked into app/config.py for either of these on
# any machine that isn't purely disposable/local -- ENCRYPTION_KEY decrypts
# every stored connector credential, and its default is committed in the
# source, not secret.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
